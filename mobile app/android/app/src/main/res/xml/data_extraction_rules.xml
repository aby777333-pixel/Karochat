<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Karochat handles its own auth/session via
     Supabase tokens stored in the WebView's HTTPS-only cookie jar; we do
     NOT want device-to-device backup of session data because that would
     leak signed-in sessions to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
