# Karochat — Android release signing keystore reference.
#
# Generate the keystore once with:
#
#   keytool -genkeypair -v \
#     -keystore karochat-release.jks \
#     -alias karochat \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Then copy this file to `keystore.properties` (in the same directory)
# and fill in the real values. Both `keystore.properties` and the .jks
# file are git-ignored — keep them out of version control.
#
# See docs/SIGNING.md for the full workflow.

storeFile=karochat-release.jks
storePassword=CHANGE_ME
keyAlias=karochat
keyPassword=CHANGE_ME
