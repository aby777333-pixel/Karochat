# Karochat mobile shell — example env file.
# Copy to `.env` and fill in. `.env` itself is git-ignored (see .gitignore).

# Override which URL the native shell loads. Defaults to production
# Netlify (https://magical-heliotrope-e4d7df.netlify.app). Useful for
# pointing a local debug build at `next dev` running on the LAN:
#
#   CAP_SERVER_URL=http://192.168.1.42:3000
#
# When pointing at HTTP (dev only), also flip `cleartext: true` in
# capacitor.config.ts. Never ship a release build with HTTP.
CAP_SERVER_URL=https://magical-heliotrope-e4d7df.netlify.app
